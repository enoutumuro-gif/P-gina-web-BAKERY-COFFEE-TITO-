---
import Layout from '../layouts/Layout.astro';
import OrderForm from '../components/OrderForm.astro';
import reviewsData from '../data/reviews.json';

const image = '/images/hero-local-tito.jpg';
const products = [
    ['01', 'Pan artesano', 'El sabor de siempre, hecho cada día.', '/images/pan-artesano.jpg'],
    ['02', 'Pizzas artesanas con masa madre', 'Para compartir. O para no compartir.', '/images/hero-pizza.jpg'],
    ['03', 'Dulce y café', 'Tu pausa también merece algo bueno.', '/images/cafe-croissant.jpg']
];
---

<Layout title="Bakery & Coffee Tito | Tu momento Bakery">
    <section class="relative grid min-h-[640px] overflow-hidden rounded-b-[2rem] border-x border-b border-white/10 lg:grid-cols-2">
        <div class="absolute inset-0 lg:relative lg:col-start-2"><img src={image} alt="Exterior de Bakery & Coffee Tito por la noche" class="h-full w-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-black via-black/55 to-black/10 lg:bg-gradient-to-r lg:from-black/20 lg:to-transparent"></div></div>
        <div class="relative z-10 flex flex-col justify-center px-7 py-20 sm:px-14 lg:col-start-1 lg:row-start-1 lg:px-16"><p class="mb-6 text-xs font-bold uppercase tracking-[0.3em] text-primary">Ourense · desde 1965</p><h1 class="max-w-xl text-6xl font-black uppercase leading-[0.88] tracking-tight sm:text-8xl">Tu lugar,<br /><span class="text-primary">Tu momento.</span></h1><p class="mt-8 max-w-md text-lg leading-relaxed text-white/75"><strong>Hay un BAKERY para cada momento del día.</strong><br />Del primer café al vermut, del vermut al tardeo.<br />Del pan recién horneado al dulce recién elaborado.<br />Del tapeo al tardeo.<br />Y cuando toca celebrar, también estamos contigo.</p><div class="mt-10 flex flex-wrap gap-3"><a href="/carta-2026.pdf" target="_blank" rel="noreferrer" class="btn btn-lg">Descubre Bakery</a><a href="#visitanos" class="rounded-full border border-white/40 px-6 py-4 font-semibold text-white no-underline transition hover:border-primary hover:text-primary">Cómo llegar <span class="ml-2">↗</span></a></div></div>
        <div class="absolute bottom-6 left-7 z-10 hidden text-xs font-bold uppercase tracking-[0.25em] text-white/60 sm:left-14 lg:block">Pan · Café · Dulce · Tapeo</div>
    </section>

    <section id="momentos" class="py-20 sm:py-28"><div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">No es solo comer</p><h2 class="mt-5 max-w-3xl text-4xl font-black uppercase leading-none sm:text-6xl">Cada persona<br />tiene su momento.</h2></div><p class="max-w-sm text-lg leading-relaxed text-white/60">Un espacio vivo para todos: la primera tostada del día, el café entre clases, la merienda en familia o el tardeo con amigos.</p></div><div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/15 bg-white/15 sm:grid-cols-2 lg:grid-cols-4">{[['Estudiantes','Café + wifi + algo dulce'],['Familias','Desayunos para todos'],['Amigos','Compartir y tardeo'],['Servicio a domicilio','Pan recién hecho']].map(([title,text]) => <article class="group bg-black p-7 transition hover:bg-primary hover:text-black">{title === 'Estudiantes' && <img src="/images/estudiantes-bakery.png" alt="Estudiantes reunidos tomando café" class="mb-6 aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />}{title === 'Familias' && <img src="/images/familia-bakery.png" alt="Familia con un niño y una niña desayunando juntos" class="mb-6 aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />}{title === 'Amigos' && <img src="/images/amigos-bakery.png" alt="Dos parejas de amigos desayunando tostas, café y zumo" class="mb-6 aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />}{title === 'Servicio a domicilio' && <img src="/images/reparto-tito.png" alt="Repartidor con casco en una scooter negra con el logo de Bakery & Coffee Tito" class="mb-6 aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />}<p class="text-3xl font-black">{title}</p><p class="mt-4 text-sm text-white/60 transition group-hover:text-black/70">{text}</p><span class="mt-10 block text-2xl">↗</span></article>)}</div></section>

    <section id="carta" class="border-y border-white/15 py-20 sm:py-28"><div class="mb-12 flex items-end justify-between gap-5"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Hecho aquí</p><h2 class="mt-4 text-4xl font-black uppercase sm:text-6xl">Lo que te apetece.</h2></div><span class="hidden text-sm text-white/50 sm:block">01 — 03</span></div><div class="grid gap-5 md:grid-cols-3">{products.map(([number,title,text,photo]) => <article class="group overflow-hidden rounded-2xl border border-white/15 bg-white/[0.04]"><div class="relative aspect-[4/3] overflow-hidden"><img src={photo} alt={title} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" /><div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div><span class="absolute left-5 top-5 text-sm font-bold text-primary">{number}</span></div><div class="p-6"><h3 class="text-2xl font-black">{title}</h3><p class="mt-3 text-white/60">{text}</p>{number === '02' && <div class="mt-5 grid grid-cols-2 items-start gap-3">{[1,2].map(index => <a href={`/images/pizzas-cartel-${index}.png`} target="_blank" rel="noreferrer" aria-label={`Ampliar cartel de pizzas artesanas ${index}`} class="block overflow-hidden rounded-lg"><img src={`/images/pizzas-cartel-${index}.png`} alt={`Pizzas artesanas con masa madre de Bakery Tito, cartel ${index}`} class="h-auto w-full" loading="lazy" /></a>)}{[1,2].map(index => <video controls playsinline preload="none" aria-label={`Vídeo de pizzas artesanas ${index}`} class="col-span-2 w-full rounded-lg bg-black"><source src={`/videos/pizzas-artesanas-${index}.mp4`} type="video/mp4" /><a href={`/videos/pizzas-artesanas-${index}.mp4`}>Ver vídeo de pizzas {index}</a></video>)}</div>}</div></article>)}</div></section>

    <section id="visitanos" class="grid gap-10 py-20 sm:py-28 lg:grid-cols-2 lg:items-center"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Ven a vernos</p><h2 class="mt-5 text-4xl font-black uppercase leading-none sm:text-6xl">La mesa<br />está puesta.</h2><p class="mt-7 max-w-md text-lg leading-relaxed text-white/65"><span class="font-bold text-white">Ubicación:</span><br />Avd. Alfonso Rguez. Castelao, 23-25</p><a href="https://www.google.com/maps?cid=10620570672187920069" target="_blank" rel="noreferrer" class="mt-4 inline-block text-sm font-bold uppercase tracking-wider text-primary no-underline">Abrir en Google Maps ↗</a><a href="tel:+34988255127" class="mt-8 inline-block text-xl font-bold text-primary">988 255 127 ↗</a></div><div class="overflow-hidden rounded-2xl border border-white/15"><iframe title="Ubicación de Bakery & Coffee Tito en Google Maps" src="https://www.google.com/maps?cid=10620570672187920069&amp;output=embed" class="h-80 w-full border-0 sm:h-96" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe></div><div class="rounded-2xl bg-primary p-8 text-black lg:col-span-2 sm:p-12"><p class="text-sm font-bold uppercase tracking-[0.25em]">Horario</p><p class="mt-6 text-3xl font-black">Lunes a viernes<br />07:30 — 22:00</p><p class="mt-3 text-3xl font-black">Sábados, domingos<br />y festivos<br />08:00 — 15:00</p></div></section>
    <section id="titinos" class="border-y border-white/15 py-20 sm:py-28"><div class="grid gap-8 sm:grid-cols-2 sm:items-center"><img src="/images/titinos-surtido.jpg" alt="Surtido de Titiños con chocolate blanco y negro" class="h-auto w-full rounded-2xl" loading="lazy" /><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">El pequeño gran capricho</p><h2 class="mt-5 text-4xl font-black uppercase sm:text-6xl">Titiños.</h2><p class="mt-6 text-lg leading-relaxed text-white/75">Pequeños bocados, grandes ganas de repetir. Descubre el acompañamiento perfecto para tu café o el detalle que alegra cualquier pausa.</p><a href="#carta" class="mt-6 inline-block font-bold text-primary">Descubrir los Titiños ↗</a></div></div><div class="mt-8 grid grid-cols-2 items-start gap-4 lg:grid-cols-4">{[["titinos-mariposas.jpg", "Titiños de chocolate decorados con mariposas"], ["titinos-plato.jpg", "Plato de Titiños variados"], ["titinos-blancos.png", "Titiños de chocolate blanco"], ["titinos-decorados.png", "Titiños de chocolate con diferentes decoraciones"]].map(([photo, alt]) => <a href={`/images/${photo}`} target="_blank" rel="noreferrer" aria-label={`Ampliar: ${alt}`} class="block overflow-hidden rounded-2xl"><img src={`/images/${photo}`} alt={alt} class="h-auto w-full transition duration-300 hover:scale-105" loading="lazy" /></a>)}</div></section>

    <section id="tartas" class="py-20 sm:py-28"><div class="grid gap-8 lg:grid-cols-2 lg:items-center"><img src="/images/tartas-fresa.jpg" alt="Tarta de fresas de Panadería Tito" class="h-72 w-full rounded-2xl object-cover sm:h-96" /><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Celebraciones con sabor</p><h2 class="mt-5 text-4xl font-black uppercase sm:text-6xl">Tartas a tu medida.</h2><p class="mt-6 text-lg leading-relaxed text-white/65">Elige tu favorita y encárgala para ese día especial. Te asesoramos por teléfono.</p><a href="tel:+34988255127" class="mt-8 inline-block font-bold text-primary">Encargar una tarta ↗</a></div></div><div class="mt-10 grid grid-cols-2 items-start gap-4 md:grid-cols-3 lg:grid-cols-4">{['Tarta de chocolate decorada', 'Tarta con frutas y chocolates para mamá', 'Tarta de chocolate con galletas', 'Tarta de cumpleaños rosa y amarilla', 'Tarta de frutas variadas', 'Tarta con frutos rojos', 'Tarta de cumpleaños de chocolate', 'Tarta de hojaldre y frutas', 'Surtido de tartas artesanas', 'Tarta personalizada con imagen', 'Tarta de zanahoria', 'Tarta de cumpleaños con chocolates y frutas', 'Selección de tartas para celebraciones', 'Tarta decorada con zanahorias', 'Tarta personalizada de chocolate', 'Tarta con chocolate y frutos rojos', 'Tarta con bombones y chocolate blanco', 'Tarta de números con fresas y nata'].map((alt, index) => <a href={`/images/tartas-cartel-${index + 1}.png`} target="_blank" rel="noreferrer" aria-label={`Ampliar: ${alt}`} class="block overflow-hidden rounded-xl border border-white/15"><img src={`/images/tartas-cartel-${index + 1}.png`} alt={alt} class="h-auto w-full" loading="lazy" /></a>)}</div></section>

        <section id="desayunos" class="border-y border-white/15 py-20 sm:py-28"><div class="grid gap-8 lg:grid-cols-2 lg:items-center"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Empieza bien el día</p><h2 class="mt-5 text-4xl font-black uppercase sm:text-6xl">Nuestros<br />desayunos.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-white/65">Sorprende con café, bollería y producto recién hecho. Haz tu pedido con antelación.</p><a href="#formulario-pedido" data-pedido="Pedir desayuno ↗" class="btn mt-8">Pedir desayuno ↗</a></div><img src="/images/cafe-croissant-2.jpg" alt="Desayuno con café y croissant" class="h-72 w-full rounded-2xl object-cover sm:h-96" /></div><div class="mt-10 grid grid-cols-2 items-start gap-4 md:grid-cols-3 lg:grid-cols-5">{['Café con tosta y nueces', 'Desayuno dulce con chocolate y fruta', 'Tosta con aguacate y tomate', 'Bol de frutas variadas', 'Tarro con cereales y fruta', 'Croissant relleno', 'Pan tostado con tomate y aguacate', 'Copa de fruta fresca', 'Café con galletas', 'Desayuno con tosta, café, zumo y croissant'].map((alt, index) => <a href={`/images/desayuno-${index + 1}.jpg`} target="_blank" rel="noreferrer" aria-label={`Ampliar: ${alt}`} class="block overflow-hidden rounded-2xl"><img src={`/images/desayuno-${index + 1}.jpg`} alt={alt} class="h-auto w-full transition duration-300 hover:scale-105" loading="lazy" /></a>)}</div><div class="mt-16"><div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Detalles que sorprenden</p><h3 class="mt-3 text-3xl font-black uppercase sm:text-4xl">Regala un momento Tito.</h3></div><p class="max-w-md text-sm leading-relaxed text-white/60">Cajas preparadas con cariño para celebrar, agradecer o empezar el día con una sonrisa. Elige tu detalle y encárgalo con antelación.</p></div><div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">{['140', '275', '278', '290', '307', '378', '501', '751', '768', '876', '1009'].map((id, index) => <a href={`/images/desayuno-regalo-${id}.jpg`} target="_blank" rel="noreferrer" aria-label={`Ampliar detalle de desayuno regalo ${index + 1}`} class="group block overflow-hidden rounded-2xl border border-white/10"><img src={`/images/desayuno-regalo-${id}.jpg`} alt={`Detalle de desayuno regalo ${index + 1}`} class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" /></a>)}</div></div></section>

    <section id="franquiciate" class="py-20 sm:py-28"><div class="rounded-3xl bg-primary p-8 text-black sm:p-14"><p class="text-xs font-bold uppercase tracking-[0.3em]">Crece con nosotros</p><h2 class="mt-5 max-w-2xl text-4xl font-black uppercase leading-none sm:text-6xl">¿Quieres abrir tu propio Tito?</h2><p class="mt-6 max-w-xl text-lg font-medium">Llevamos nuestra forma de hacer las cosas a nuevos lugares. Cuéntanos tu proyecto.</p><a href="#formulario-pedido" data-pedido="Quiero información ↗" class="mt-8 inline-block rounded-full bg-black px-6 py-4 font-bold text-white no-underline">Quiero información ↗</a></div></section>

    <section id="pedidos" class="border-y border-white/15 py-20 sm:py-28"><div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Para llevar, regalar o celebrar</p><h2 class="mt-5 text-4xl font-black uppercase leading-none sm:text-6xl">Lo preparamos<br />para ti.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-white/65">Encarga tus productos del obrador con antelación.</p><a href="#formulario-pedido" data-pedido="Hacer un encargo ↗" class="btn mt-8">Hacer un encargo ↗</a></div><div class="grid gap-3 sm:grid-cols-2"><article class="rounded-2xl bg-primary p-7 text-black"><h3 class="text-2xl font-black">Regalos</h3><p class="mt-3 font-medium">Cestas y cajas para sorprender.</p></article><article class="rounded-2xl border border-white/20 p-7"><h3 class="text-2xl font-black">A domicilio</h3><p class="mt-3 text-white/65">Consulta zonas y disponibilidad.</p></article></div></div></section>

    <section id="eventos" class="py-20 sm:py-28"><div class="grid gap-10 lg:grid-cols-2"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Momentos que se comparten</p><h2 class="mt-5 text-4xl font-black uppercase leading-none sm:text-6xl">Tu celebración,<br />a nuestra manera.</h2></div><div><p class="text-lg leading-relaxed text-white/70">Cumpleaños, reuniones de empresa, meriendas y encuentros con amigos. Tú pones la fecha; nosotros ponemos una mesa que se recuerda.</p><a href="tel:+34988255127" class="mt-8 inline-block font-bold text-primary">Cuéntanos tu idea ↗</a></div></div></section>

    <section id="nosotros" class="rounded-3xl bg-white/10 p-8 sm:p-14">
        <div class="grid gap-8 lg:grid-cols-2 lg:items-end"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Nuestra historia</p><h2 class="mt-5 text-4xl font-black uppercase sm:text-6xl">Desde 1965,<br />cerca de ti.</h2></div><p class="max-w-lg text-lg leading-relaxed text-white/70">Una tradición familiar de Ourense que crece sin perder lo importante: hacer las cosas con mimo y recibir a cada persona como en casa.</p></div>
        <div class="mt-10 flex flex-col items-start gap-6 border-t border-white/15 pt-8 sm:flex-row sm:items-center">
            <div class="w-56 max-w-full shrink-0 rounded-xl bg-white p-5"><img src="/images/calidad-turistica.jpg" alt="Sello Q de Calidad Turística" width="1420" height="819" class="h-auto w-full" loading="lazy" /></div>
            <div><h3 class="text-xl font-bold text-primary">Q de Calidad Turística</h3><p class="mt-2 max-w-lg leading-relaxed text-white/70">Un reconocimiento a nuestro compromiso con la calidad y con cada persona que nos visita.</p></div>
        </div>
    </section>

    <section id="resenas" class="border-y border-white/15 py-20 sm:py-28">
        <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
            <div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Lo dicen nuestros clientes</p><h2 class="mt-5 text-4xl font-black uppercase leading-none sm:text-6xl">Opiniones de<br /><span class="text-primary">nuestros clientes.</span></h2></div>
            <div class="rounded-2xl bg-primary px-6 py-5 text-black"><p class="text-4xl font-black">{reviewsData.overallRating} <span class="text-xl">★</span></p><p class="mt-1 text-sm font-semibold">Valoración global en Google · {reviewsData.totalReviews} reseñas</p></div>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{reviewsData.reviews.filter(review => review.rating === 4 || review.rating === 5).slice(0, 6).map(review => <article class="rounded-2xl border border-white/15 bg-white/[0.04] p-7"><p class="text-xl text-primary" aria-label={`${review.rating} de 5 estrellas`}>{'★'.repeat(review.rating)}{'☆'.repeat(5 - review.rating)}</p><blockquote class="mt-5 text-xl leading-relaxed text-white/80">“{review.excerpt}”</blockquote><p class="mt-6 font-bold">{review.author}</p><p class="mt-2 text-xs text-white/50">{review.dateLabel}</p><a href={review.source} target="_blank" rel="noreferrer" class="mt-4 inline-block text-sm text-primary">Google Maps ↗</a></article>)}</div>
        <p class="mt-8 text-sm text-white/50">Extractos de reseñas. Consultadas el <time datetime={reviewsData.verifiedAt}>{reviewsData.verifiedAt.split('-').reverse().join('/')}</time>. <a href={reviewsData.googleUrl} target="_blank" rel="noreferrer" class="btn mt-5 inline-flex">Ver todas las opiniones en Google ↗</a></p>
    </section>

    <section id="contacto" class="py-20 sm:py-28"><div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Hablemos</p><h2 class="mt-4 text-4xl font-black uppercase sm:text-6xl">¿Te ayudamos?</h2></div><div class="text-lg text-white/70"><p><a href="mailto:informacion@panaderiatito.com" class="text-primary">informacion@panaderiatito.com</a></p><p class="mt-2">988 255 127 · 666 528 188 · 627 509 613</p></div></div></section>

    <section id="pan" class="border-y border-white/15 py-20 sm:py-28"><div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center"><div class="grid gap-4 sm:grid-cols-2"><img src="/images/pan-variedades.jpg" alt="Variedad de panes artesanos" class="h-64 w-full rounded-2xl object-cover sm:col-span-2 sm:h-80" /><img src="/images/pan-rustico.jpg" alt="Pan rústico recién horneado" class="h-48 w-full rounded-2xl object-cover" /><img src="/images/pan-semillas.jpg" alt="Pan de semillas" class="h-48 w-full rounded-2xl object-cover" /></div><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Del horno a tu mesa</p><h2 class="mt-5 text-4xl font-black uppercase leading-none sm:text-6xl">Pan con historia.<br /><span class="text-primary">Sabor de hoy.</span></h2><p class="mt-6 text-lg leading-relaxed text-white/70">Harinas seleccionadas, reposo y mucho oficio. Cada hogaza sale con corteza crujiente, miga tierna y ese aroma que convierte cualquier comida en un momento especial.</p><p class="mt-4 text-lg leading-relaxed text-white/70">Elige tu formato favorito y llévatelo recién hecho para disfrutarlo en casa.</p><a href="#formulario-pedido" data-pedido="Encargar mi pan ↗" class="btn mt-8">Encargar mi pan ↗</a></div></div><div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-4"><img src="/images/pan-campesino.jpg" alt="Pan campesino" class="h-36 w-full rounded-xl object-cover" /><img src="/images/pan-hogaza.jpg" alt="Hogaza artesanal" class="h-36 w-full rounded-xl object-cover" /><img src="/images/pan-tradicion.jpg" alt="Pan tradicional" class="h-36 w-full rounded-xl object-cover" /><img src="/images/pan-mezcla.jpg" alt="Pan de mezcla" class="h-36 w-full rounded-xl object-cover" /><img src="/images/pan-artesano-2.jpg" alt="Pan artesano" class="h-36 w-full rounded-xl object-cover" /><img src="/images/barras-pan.jpg" alt="Barras de pan" class="h-36 w-full rounded-xl object-cover" /><img src="/images/barras-tradicionales.jpg" alt="Barras tradicionales" class="h-36 w-full rounded-xl object-cover" /><img src="/images/pan-casero.jpg" alt="Pan casero" class="h-36 w-full rounded-xl object-cover" /></div></section>

    <section id="empanadas" class="py-20 sm:py-28"><div class="grid gap-10 lg:grid-cols-2 lg:items-center"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Para compartir</p><h2 class="mt-5 text-4xl font-black uppercase leading-none sm:text-6xl">Empanadas<br /><span class="text-primary">que reúnen.</span></h2><p class="mt-6 max-w-xl text-lg leading-relaxed text-white/70">Una masa dorada, un relleno sabroso y ese momento de cortar el primer trozo. Nuestras empanadas están hechas para llevar al centro de la mesa y desaparecer entre “qué buenas están” y “¿queda otro trozo?”.</p><p class="mt-4 max-w-xl text-lg leading-relaxed text-white/70">Encárgalas para una comida familiar, una reunión o cualquier plan que merezca algo rico.</p><a href="#formulario-pedido" data-pedido="Encargar empanadas ↗" class="btn mt-8">Encargar empanadas ↗</a></div><div class="relative overflow-hidden rounded-3xl"><img src="/images/empanada-tito.jpg" alt="Empanada de Panadería Tito recién horneada" class="h-80 w-full object-cover sm:h-[30rem]" /><div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div><p class="absolute bottom-6 left-6 right-6 text-xl font-bold text-white">El plan empieza cuando llega el olor del horno.</p></div></div>  <div class="mt-12">
    <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">Hechas para compartir</p><h3 class="mt-3 text-3xl font-black uppercase leading-none sm:text-4xl">Una empanada<br /><span class="text-primary">para cada plan.</span></h3></div>
      <p class="max-w-md text-base leading-relaxed text-white/60">Masa dorada, rellenos sabrosos y el sabor casero que reúne a todos alrededor de la mesa.</p>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
