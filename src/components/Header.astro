---
const navItems = [
    { linkText: 'Titiños', href: '#titinos' },
    { linkText: 'Pan', href: '#pan' },
    { linkText: 'Empanadas', href: '#empanadas' },
    { linkText: 'Eventos', href: '#eventos' },
    { linkText: 'Tartas', href: '#tartas' },
    { linkText: 'Desayunos a domicilio', href: '#desayunos' },
    { linkText: 'Franquíciate', href: '#franquiciate' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-6 border-b border-white/20 py-6 sm:py-8">
    <a href="/" class="text-xl font-black tracking-tight no-underline text-white">BAKERY <span class="text-white/60">&amp; COFFEE</span> TITO</a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-1.5 py-1 text-sm font-semibold no-underline text-white/80 hover:text-white sm:px-3 sm:py-2">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
